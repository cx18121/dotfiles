#!/bin/sh

set -eu

export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin"

if ! docker info >/dev/null 2>&1; then
  printf '%s Docker is unavailable; skipping cleanup.\n' "$(date)"
  exit 0
fi

if pgrep -f '[d]ocker (buildx )?build' >/dev/null; then
  printf '%s A Docker build is active; skipping cleanup.\n' "$(date)"
  exit 0
fi

date
docker buildx prune --all --force --max-used-space 20gb --reserved-space 5gb
docker image prune --all --force --filter 'until=168h'
docker network prune --force --filter 'until=168h'
docker volume prune --force
docker system df
